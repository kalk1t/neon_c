cmake_minimum_required(VERSION 3.24)
project(RoadstersRace VERSION 0.1.0 LANGUAGES C)

set(CMAKE_C_STANDARD 17)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_C_EXTENSIONS OFF)
if(MSVC)
    # The pinned official raylib static library was built with the release DLL CRT.
    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreadedDLL")
endif()
option(RR_BUILD_APP "Build the first-flight application" ON)
option(RR_BUILD_TESTS "Build headless reference tests" ON)
set(RR_RAYLIB_SOURCE_DIR "" CACHE PATH "Pinned raylib source for browser/source builds")

add_library(rr_core STATIC src/presentation/rr_results_slots.c src/presentation/rr_results_caption.c src/presentation/rr_results_tracks.c src/presentation/rr_results_label.c src/presentation/rr_results_body_flow.c src/presentation/rr_results_list_flow.c src/presentation/rr_results_name_flow.c src/presentation/rr_results_advance.c src/core/rr_audio_dispatch.c src/core/rr_audio_cues.c src/core/rr_audio_current.c src/presentation/rr_results_summary.c src/presentation/rr_results_bind.c src/presentation/rr_results_times.c src/presentation/rr_results_ui.c src/core/rr_results_timer.c src/core/rr_results_current.c src/core/rr_run_input.c src/core/rr_run_current.c src/core/rr_player_phase.c src/core/rr_session_pose.c src/core/rr_car_pose.c src/core/rr_battle_current.c src/core/rr_rival_arsenal.c src/core/rr_rival_lifecycle.c src/core/rr_ai_current.c src/core/rr_rival_current.c src/core/rr_weapon_current.c src/core/rr_input_settings.c src/core/rr_local_run.c src/core/rr_battle.c src/core/rr_fire.c src/core/rr_combat.c src/core/rr_arsenal.c src/core/rr_targeting.c src/core/rr_pack.c src/core/rr_coins.c src/core/rr_rival.c src/core/rr_ai.c src/core/rr_flight.c src/core/rr_track.c src/core/rr_race.c src/core/rr_session.c src/core/rr_recovery.c src/core/rr_road_picker.c src/core/rr_corridor.c src/core/rr_city_plan.c src/core/rr_finish.c src/core/rr_physics.c src/core/rr_world_plan.c src/core/rr_course_plan.c src/core/rr_shared_scenery.c src/core/rr_canonical_city.c src/core/rr_facade.c)
target_include_directories(rr_core PUBLIC src/core)
if(MSVC)
    target_compile_options(rr_core PRIVATE /W4 /WX /fp:precise)
else()
    target_compile_options(rr_core PRIVATE -Wall -Wextra -Wpedantic)
    target_link_libraries(rr_core PUBLIC m)
endif()

add_library(rr_input_preferences STATIC src/platform/rr_input_preferences.c)
target_include_directories(rr_input_preferences PUBLIC src/platform)
target_link_libraries(rr_input_preferences PUBLIC rr_core)
if(EMSCRIPTEN)
    set_target_properties(rr_input_preferences PROPERTIES C_EXTENSIONS ON)
endif()
if(MSVC)
    target_compile_options(rr_input_preferences PRIVATE /W4 /WX)
else()
    target_compile_options(rr_input_preferences PRIVATE -Wall -Wextra -Wpedantic -Werror)
endif()

