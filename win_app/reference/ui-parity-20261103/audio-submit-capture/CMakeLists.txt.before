# RRInput's appended optional strafe/aim flag are zero in historical positional
# fixtures (C aggregate initialization). Keep those reference records unchanged.
# Apply after per-target -Wextra so this single warning stays suppressed.
if(NOT MSVC)
    get_property(RR_LOCAL_TARGETS DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
    foreach(RR_TARGET IN LISTS RR_LOCAL_TARGETS)
        target_compile_options(${RR_TARGET} PRIVATE -Wno-missing-field-initializers)
    endforeach()
endif()

