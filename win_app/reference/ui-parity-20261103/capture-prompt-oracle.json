  "hint_statement": "e.hint.style.display = g.state === 'race' && !g.mouseLocked ? 'block' : 'none';",
  "canvas_click": "renderer.domElement.addEventListener('click', () => {\n  if (g.state === 'race' || g.state === 'countdown') captureMouse();\n}",
  "capture_mouse": "function captureMouse() {\n  if (!touch) input.lock(renderer.domElement, racing);\n}",
  "racing": "function racing() {\n  return g.state === 'race' || g.state === 'countdown';\n}",
