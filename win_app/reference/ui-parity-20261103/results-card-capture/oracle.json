    "* { box-sizing: border-box; }",
    "* { zoom: 0.8; }",
    "* { zoom: 0.55; }",
    "* { zoom: 0.6; }",
    "#menu, #pause, #results { position: fixed; inset: 0; display: flex; align-items: center; padding-left: 7vw; background: linear-gradient(90deg, rgba(3, 4, 20, 0.85) 0%, rgba(3, 4, 20, 0.35) 45%, transparent 70%); z-index: 10; }",
    "#pause, #results { position: fixed; inset: 0; display: flex; align-items: center; padding-left: 7vw; background: linear-gradient(90deg, rgba(3, 4, 20, 0.85) 0%, rgba(3, 4, 20, 0.35) 45%, transparent 70%); z-index: 10; }",
    "#pause, #results { justify-content: center; padding: 0; background: rgba(3, 4, 20, 0.55); }",
    "#menu, #results { overflow-y: auto; align-items: safe center; padding-top: 16px; padding-bottom: 16px; }",
    ".menu-card { gap: 9px; }",
    ".menu-card { width: 470px; display: flex; flex-direction: column; gap: 14px; }",
    ".menu-card { cursor: default; }",
    ".menu-card { zoom: 0.5; margin: auto 0; }",
    ".menu-card { flex-shrink: 0; gap: 9px; padding: 22px 30px; }",
    ".menu-card.small { width: 380px; padding: 30px; background: var(--bg); border: 2px solid var(--c); box-shadow: 0 0 30px rgba(25, 230, 255, 0.4); }",
    ".menu-card.wide { width: 520px; }",
    ".menu-card.wide { width: 680px; }",
    "#results > .menu-card { flex-shrink: 0; gap: 9px; padding: 22px 30px; }",
    "#res-laps { font: 700 18px var(--font); color: #cfefff; }",
    "#res-laps { display: flex; justify-content: center; gap: 28px; margin: 0; padding: 0; list-style: none; font-size: 16px; }",
    "#res-unlock.hidden, #res-next.hidden { display: none; }"
