{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neon Circuit authored closed route v1",
  "type": "object",
  "required": [
    "schema_version",
    "map_id",
    "map_name",
    "authored_layout_note",
    "coordinate_system",
    "closed",
    "interpolation",
    "route_width_m",
    "deck_below_route_m",
    "deck_thickness_m",
    "nominal_vehicle",
    "design_limits",
    "environment",
    "control_points",
    "computed",
    "checkpoints",
    "spawns",
    "race_order",
    "sectors",
    "hazards"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "map_id": {
      "enum": [
        "R1",
        "R3"
      ]
    },
    "map_name": {
      "type": "string"
    },
    "authored_layout_note": {
      "type": "string"
    },
    "coordinate_system": {
      "const": "game_x_right_y_up_z_forward_meters"
    },
    "closed": {
      "const": true
    },
    "interpolation": {
      "type": "object",
      "required": [
        "type",
        "samples_per_span",
        "length_method"
      ],
      "properties": {
        "type": {
          "const": "closed_uniform_catmull_rom"
        },
        "samples_per_span": {
          "type": "integer",
          "minimum": 8
        },
        "length_method": {
          "type": "string"
        }
      }
    },
    "route_width_m": {
      "const": 18
    },
    "deck_below_route_m": {
      "const": 3
    },
    "deck_thickness_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nominal_vehicle": {
      "type": "object",
      "required": [
        "length_m",
        "width_m",
        "assumed_height_for_blockout_m",
        "height_note"
      ],
      "properties": {
        "length_m": {
          "const": 5.6
        },
        "width_m": {
          "const": 3.92
        },
        "assumed_height_for_blockout_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_note": {
          "type": "string"
        }
      }
    },
    "design_limits": {
      "type": "object",
      "required": [
        "footprint_target_xz_m",
        "minimum_elevation_m",
        "maximum_elevation_m",
        "maximum_grade_degrees",
        "minimum_horizontal_turn_radius_m"
      ],
      "properties": {
        "footprint_target_xz_m": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "minimum_elevation_m": {
          "type": "number"
        },
        "maximum_elevation_m": {
          "type": "number"
        },
        "maximum_grade_degrees": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_horizontal_turn_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "control_points": {
      "type": "array",
      "minItems": 16,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "id",
          "position_game"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P[0-9]{2}$"
          },
          "position_game": {
            "$ref": "#/$defs/vec3"
          }
        }
      }
    },
    "computed": {
      "type": "object",
      "required": [
        "length_m",
        "bounds_min_game",
        "bounds_max_game",
        "maximum_grade_degrees",
        "minimum_horizontal_turn_radius_m"
      ],
      "properties": {
        "length_m": {
          "type": "number",
          "minimum": 2000,
          "maximum": 4000
        },
        "bounds_min_game": {
          "$ref": "#/$defs/vec3"
        },
        "bounds_max_game": {
          "$ref": "#/$defs/vec3"
        },
        "maximum_grade_degrees": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_horizontal_turn_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "minItems": 8,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/pose"
          },
          {
            "type": "object",
            "required": [
              "id",
              "sequence",
              "asset_id",
              "inner_diameter_m",
              "ring_outer_diameter_m",
              "trigger_center_radius_m",
              "trigger_radius_note",
              "required_crossing",
              "respawn"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^CP[0-9]{2}$"
              },
              "sequence": {
                "type": "integer",
                "minimum": 0
              },
              "asset_id": {
                "enum": [
                  "C04",
                  "C05"
                ]
              },
              "inner_diameter_m": {
                "const": 22
              },
              "ring_outer_diameter_m": {
                "const": 26
              },
              "trigger_center_radius_m": {
                "const": 9
              },
              "trigger_radius_note": {
                "type": "string"
              },
              "required_crossing": {
                "const": "negative_to_positive_signed_distance_along_forward_normal"
              },
              "respawn": {
                "allOf": [
                  {
                    "$ref": "#/$defs/pose"
                  },
                  {
                    "type": "object",
                    "required": [
                      "behind_checkpoint_m",
                      "zero_linear_velocity",
                      "next_required_checkpoint"
                    ],
                    "properties": {
                      "behind_checkpoint_m": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "zero_linear_velocity": {
                        "type": "boolean"
                      },
                      "next_required_checkpoint": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "spawns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/pose"
          },
          {
            "type": "object",
            "required": [
              "id",
              "next_required_checkpoint",
              "initial_lap_state"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "next_required_checkpoint": {
                "type": "string"
              },
              "initial_lap_state": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "weather",
        "water_level_y_m",
        "water_extent_xz_m",
        "water_center_xz",
        "palette"
      ],
      "properties": {
        "weather": {
          "const": "rain"
        },
        "water_level_y_m": {
          "type": "number"
        },
        "water_extent_xz_m": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "water_center_xz": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "palette": {
          "type": "object",
          "required": [
            "body",
            "route_light",
            "accent"
          ]
        }
      }
    },
    "race_order": {
      "type": "object"
    },
    "sectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "start_distance_m",
          "end_distance_m"
        ]
      }
    },
    "hazards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "collision"
        ]
      }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "pose": {
      "type": "object",
      "required": [
        "distance_m",
        "position_game",
        "forward_game"
      ],
      "properties": {
        "distance_m": {
          "type": "number",
          "minimum": 0
        },
        "position_game": {
          "$ref": "#/$defs/vec3"
        },
        "forward_game": {
          "$ref": "#/$defs/vec3"
        }
      }
    }
  }
}
